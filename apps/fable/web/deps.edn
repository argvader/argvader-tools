{:deps
 {re-frame/re-frame                {:mvn/version "1.4.3"}
  reagent/reagent                  {:mvn/version "1.2.0"}
  bidi/bidi                        {:mvn/version "2.1.6"}
  lifecheq/pushy                   {:mvn/version "0.3.9"}
  stylefy/stylefy                  {:mvn/version "3.2.0"}
  stylefy/reagent                  {:mvn/version "3.0.0"}
  day8.re-frame/re-frame-10x       {:mvn/version "1.11.0"}
  day8.re-frame/http-fx            {:mvn/version "0.2.4"}
  aero/aero                        {:mvn/version "1.1.6"}
  thheller/shadow-cljs             {:mvn/version "2.28.18"}
  local/libs                       {:local/root "../../../libs"}
  local/tools                      {:local/root "../../../tools"}}

 :paths ["src/cljs" "resources"]

 :aliases
 {:watch   {:main-opts ["-m" "build.cljs.dev" "dev"]
            :extra-deps {binaryage/devtools {:mvn/version "RELEASE"}
                         binaryage/dirac    {:mvn/version "RELEASE"}}}
  :build   {:main-opts ["-m" "build.cljs.minified" "prod"]}
  :release {:main-opts ["-m" "build.s3.core"]
            :extra-deps {amazonica/amazonica {:mvn/version "0.3.167"}}}
  :nrepl   {:extra-deps {nrepl/nrepl {:mvn/version "RELEASE"}}
            :main-opts  ["-m" "nrepl.cmdline"]}}}
