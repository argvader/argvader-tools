{:secrets #include "secrets.edn"

 :service {:name    "ttrpg-session"
           :version "0.1.0"}

 :ttrpg-db #profile
 {:dev  {:dbtype   "postgresql"
         :dbname   "ttrpg_session"
         :host     "localhost"
         :port     5432
         :user     #ref [:secrets :ttrpg-db :username]
         :password #ref [:secrets :ttrpg-db :password]}
  :prod {:dbtype   "postgresql"
         :dbname   "ttrpg_session"
         :host     #env DB_HOST
         :port     5432
         :user     #env DB_USER
         :password #env DB_PASSWORD}}

 :discord {:token      #profile {:dev #ref [:secrets :discord :token]
                                 :prod #env DISCORD_TOKEN}
           :bot-secret #profile {:dev #ref [:secrets :discord :bot-secret]
                                 :prod #env BOT_SECRET}}

 :openai {:api-key       #profile {:dev #ref [:secrets :openai :api-key]
                                   :prod #env OPENAI_API_KEY}
          :model         "gpt-4o"
          :max-tokens    4096
          :whisper-model "whisper-1"}

 :github {:token  #profile {:dev #ref [:secrets :github :token]
                           :prod #env GITHUB_TOKEN}
          :owner  #profile {:dev #ref [:secrets :github :owner]
                            :prod #env GITHUB_OWNER}
          :repo   #profile {:dev #ref [:secrets :github :repo]
                            :prod #env GITHUB_REPO}
          :branch "main"}}
